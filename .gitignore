# FRONTEND
frontend/node_modules/
frontend/dist/
frontend/.vite/

# BACKEND
backend/node_modules/
backend/.env

# SCRIPT UTILITAS LOKAL (jangan ikut deploy)
backend/*-sub.js
backend/sub.js
backend/check-db.js

# SYSTEM & ENVIRONMENT
.DS_Store
Thumbs.db
.env
.env.local
.vscode/
*.log

# DOKUMENTASI
# Hanya readme.md di root yang dipublikasikan. Garis miring di depan (/) membatasi
# pengecualian hanya untuk folder root, sehingga README.md di subfolder tetap diabaikan.
*.md
!/readme.md
!/README.md
!/graphify-out/GRAPH_REPORT.md

# GRAPHIFY (peta arsitektur kode)
# Artefak hasil (graph.json, graph.html, GRAPH_REPORT.md, label, manifest) ikut
# di-commit supaya bisa dibaca tanpa menjalankan graphify. Sisanya bersifat lokal:
# cache AST/semantic, snapshot cadangan bertanggal, dan state build.
graphify-out/cache/
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/.graphify_build_state.json
graphify-out/.graphify_partition_cache.json
graphify-out/.graphify_labels.json.sig
graphify-out/.graphify_labels.pending.json
# Visualisasi & state build: besar (~578 KB) dan dibuat ulang tiap update,
# sehingga hanya menambah riwayat git. Regenerate dengan `graphify export html`.
graphify-out/graph.html
graphify-out/manifest.json
graphify-out/.graphify_analysis.json
graphify-out/cost.json
