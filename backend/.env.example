# ============================================================
# Template environment backend TypoKu
# Salin file ini menjadi .env lalu isi nilainya.
# JANGAN commit file .env yang berisi nilai sebenarnya.
# ============================================================

# Server
PORT=8000
NODE_ENV=development
APP_URL=http://localhost:5173

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=typoku
DB_SSL=false
DB_SSL_CA=ca.pem

# Autentikasi
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# Reset kata sandi
RESET_TOKEN_TTL_MINUTES=60

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alamat@gmail.com
SMTP_PASS=app-password
MAIL_FROM="TypoKu <alamat@gmail.com>"

# Gemini AI
GEMINI_API_KEY=AIza-ganti-dengan-api-key-gemini
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_FALLBACKS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.7-flash,gemini-flash-latest
GEMINI_MODEL_COOLDOWN_MS=300000
GEMINI_TYPO_TIMEOUT_MS=60000
GEMINI_TEXT_TIMEOUT_MS=30000

# Midtrans
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxx
MIDTRANS_IS_PRODUCTION=false
PAYMENT_METHODS=qris,dana,ovo
PAYMENT_RECONCILE_MINUTES=60
ADMIN_FEE=700
